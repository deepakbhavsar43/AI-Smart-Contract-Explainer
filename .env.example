# Copy to .env and fill in. Never commit .env.

# Needed for "Verified address" lookups (free key: https://etherscan.io/myapikey). One key covers all supported chains.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------- AI provider
# auto = first provider that has a key, in this order: anthropic, gemini, groq, openai
# or set one explicitly: anthropic | gemini | groq | openai | ollama | none
LLM_PROVIDER=auto

# FREE option 1 - Google Gemini (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# FREE option 2 - Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# FREE option 3 - Ollama on your own machine (no key, no internet): https://ollama.com
#   ollama pull qwen2.5-coder:7b   then set LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Paid options
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (point at any OpenAI-compatible server, e.g. OpenRouter)

# ---------------------------------------------------------------- cost / abuse guards
LLM_MAX_FUNCTIONS=40       # lower to ~15 on free tiers to stay inside daily limits
# LLM_CONCURRENCY=          # blank = provider default (gemini 2, groq 1, ollama 1)
RATE_LIMIT_PER_HOUR=30
MAX_SOURCE_BYTES=600000

# Only needed if the frontend is hosted on a different origin, comma-separated
CORS_ORIGINS=
